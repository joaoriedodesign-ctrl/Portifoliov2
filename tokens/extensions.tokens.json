{
  "$note": "EXTENSÕES DO CÓDIGO — estes tokens NÃO existem no Figma. Foram criados porque o arquivo não define espaçamento, raio, borda, sombra, foco nem movimento. Seguem a mesma convenção (Primitive com valores, Semantic com aliases →). Se forem aprovados, recrie-os no Figma com os mesmos nomes.",
  "collections": {
    "Typography / Semantic (override do código)": {
      "$note": "Decisão de 25/09/2026: o site usa somente Outfit. Substitui font-family e font-weight de Display e Heading do Figma (que apontam para Righteous Regular). Tamanhos e alturas de linha continuam os do Figma.",
      "override": true,
      "modes": [
        "Default"
      ],
      "variables": {
        "Display/Large/font-family": "→ font-family/Outfit",
        "Display/Large/font-weight": "→ font-weight/bold",
        "Display/Small/font-family": "→ font-family/Outfit",
        "Display/Small/font-weight": "→ font-weight/bold",
        "Heading/H1/font-family": "→ font-family/Outfit",
        "Heading/H1/font-weight": "→ font-weight/bold",
        "Heading/H2/font-family": "→ font-family/Outfit",
        "Heading/H2/font-weight": "→ font-weight/bold",
        "Heading/H3/font-family": "→ font-family/Outfit",
        "Heading/H3/font-weight": "→ font-weight/semibold",
        "Heading/H4/font-family": "→ font-family/Outfit",
        "Heading/H4/font-weight": "→ font-weight/semibold",
        "Heading/H5/font-family": "→ font-family/Outfit",
        "Heading/H5/font-weight": "→ font-weight/semibold",
        "Heading/H6/font-family": "→ font-family/Outfit",
        "Heading/H6/font-weight": "→ font-weight/semibold"
